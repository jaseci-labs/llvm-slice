# A cross-compiled rustc's sysroot leaves out the proc macros built for the
# host it is for: bootstrap told them apart from the compiler's own dylibs
# by file name, which differs from the build machine's copy there.
--- a/src/bootstrap/src/core/build_steps/compile.rs
+++ b/src/bootstrap/src/core/build_steps/compile.rs
@@ -2332,12 +2332,22 @@
 
         // Link in all dylibs to the libdir
         let stamp = build_stamp::librustc_stamp(builder, build_compiler, target_compiler.host);
+        // The proc macros, by crate name: a cross-compiled rustc's build
+        // (`-Zdual-proc-macros`) also builds each for the host it is for,
+        // under another file name (`serde_derive-<hash>.dll` beside the build
+        // machine's `libserde_derive-<hash>.so`), which the compiler does not
+        // load either.
+        let crate_name = |filename: &str| -> String {
+            let stem = filename.split('.').next().unwrap_or(filename);
+            let stem = stem.strip_prefix("lib").unwrap_or(stem);
+            stem.rsplit_once('-').map_or(stem, |(name, _)| name).to_owned()
+        };
         let proc_macros = builder
             .read_stamp_file(&stamp)
             .into_iter()
             .filter_map(|(path, dependency_type)| {
                 if dependency_type == DependencyType::Host {
-                    Some(path.file_name().unwrap().to_owned().into_string().unwrap())
+                    Some(crate_name(path.file_name().unwrap().to_str().unwrap()))
                 } else {
                     None
                 }
@@ -2351,7 +2361,7 @@
         for f in builder.read_dir(&src_libdir) {
             let filename = f.file_name().into_string().unwrap();
 
-            let is_proc_macro = proc_macros.contains(&filename);
+            let is_proc_macro = proc_macros.contains(&crate_name(&filename));
             let is_dylib_or_debug = is_dylib(&f.path()) || is_debug_info(&filename);
 
             // If we link statically to stdlib, do not copy the libstd dynamic library file
