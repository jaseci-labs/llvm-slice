# rustc links an LLVM library that carries rustc_llvm's wrapper itself (neojac's
# libneollvm): with LLVM_PROVIDES_RUSTC_WRAPPER set, rustc_llvm compiles no
# wrapper and links no C++ runtime or LLVM dependency, and rustc_codegen_llvm
# names no llvm-wrapper library. The wrapper takes the function it appends to
# a Rust string with (LLVMRustSetStringWriter) instead of naming a Rust
# function, which a library linked before Rust cannot do.
diff -ruN a/compiler/rustc_codegen_llvm/build.rs b/compiler/rustc_codegen_llvm/build.rs
--- a/compiler/rustc_codegen_llvm/build.rs
+++ b/compiler/rustc_codegen_llvm/build.rs
@@ -0,0 +1,10 @@
+// An LLVM library may carry `rustc_llvm`'s wrapper itself (see its build
+// script): then nothing builds the static `llvm-wrapper` library, and the
+// wrapper's functions come from the LLVM library `rustc_llvm` links.
+fn main() {
+    println!("cargo::rustc-check-cfg=cfg(llvm_wrapper_in_llvm)");
+    println!("cargo::rerun-if-env-changed=LLVM_PROVIDES_RUSTC_WRAPPER");
+    if std::env::var_os("LLVM_PROVIDES_RUSTC_WRAPPER").is_some() {
+        println!("cargo::rustc-cfg=llvm_wrapper_in_llvm");
+    }
+}
